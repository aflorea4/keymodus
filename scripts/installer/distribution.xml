<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Keymodus</title>
    <organization>dev.keymodus</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="pkg-background.tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="pkg-background-dark.tiff" alignment="bottomleft" scaling="none"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Keymodus" versStr="@VERSION@">
        <pkg-ref id="dev.keymodus.app"/>
    </choice>
    <pkg-ref id="dev.keymodus.app" version="@VERSION@" onConclusion="none">Keymodus-component.pkg</pkg-ref>
</installer-gui-script>
